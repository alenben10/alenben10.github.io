---
import profile from "../lib/profile";
import AndeanBand from "./AndeanBand.astro";

interface Props {
  variant?: "home" | "detail";
}
const { variant = "home" } = Astro.props;
const prefix = variant === "home" ? "" : "/";
const links = [
  { href: `${prefix}#about`, label: "About" },
  { href: `${prefix}#research`, label: "Research" },
  { href: `${prefix}#publications`, label: "Publications" },
  { href: `${prefix}#projects`, label: "Projects" },
  { href: `${prefix}#experience`, label: "Experience" },
];
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<AndeanBand id="band-top" class="band-top" height="12" />
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/">
      <span class="brand-name">{profile.fullName}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nav-cv" href={profile.cvUrl}>CV</a>
    </nav>
  </div>
</header>
