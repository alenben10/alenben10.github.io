---
import profile from "../lib/profile";

interface Props {
  variant?: "home" | "detail";
}

const { variant = "home" } = Astro.props;
const isHome = variant === "home";
const links = isHome
  ? [
      { href: "#about", label: "About" },
      { href: "#experience", label: "Research" },
      { href: "#publications", label: "Publications" },
      { href: "#projects", label: "Projects" },
    ]
  : [
      { href: "/", label: "Home" },
      { href: "/#publications", label: "Publications" },
      { href: "/#projects", label: "Projects" },
      { href: "/#contact", label: "Contact" },
    ];
const contactHref = `mailto:${profile.email}?subject=${encodeURIComponent("Portfolio contact")}`;
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header class:list={["site-header", !isHome && "detail-header"]}>
  <div class="header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">AZ</span>
      <span class="brand-text">{profile.fullName}</span>
    </a>
    <nav class="nav" aria-label={isHome ? "Primary navigation" : "Page navigation"}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="header-cta" href={contactHref}>Email</a>
  </div>
</header>
