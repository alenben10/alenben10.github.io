---
// An original stepped-diamond motif inspired by Andean textiles.
// `id` must be unique on the page because SVG patterns are referenced by id.
interface Props {
  id: string;
  class?: string;
  height?: string;
}
const { id, class: className, height = "20" } = Astro.props;
---

<svg class:list={["andean-band", className]} width="100%" height={height} aria-hidden="true" focusable="false">
  <defs>
    <pattern id={id} width="28" height="20" patternUnits="userSpaceOnUse">
      <rect class="b-bg" width="28" height="20" />
      <rect class="b-line" width="28" height="2" />
      <rect class="b-line" y="18" width="28" height="2" />
      <polygon
        class="b-main"
        points="12,4 16,4 16,6 18,6 18,8 20,8 20,12 18,12 18,14 16,14 16,16 12,16 12,14 10,14 10,12 8,12 8,8 10,8 10,6 12,6"
      />
      <rect class="b-bg" x="13" y="9" width="2" height="2" />
      <polygon class="b-gold" points="0,6 4,10 0,14" />
      <polygon class="b-gold" points="28,6 24,10 28,14" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
