---
import { faGithub, faLinkedinIn } from "@fortawesome/free-brands-svg-icons";

interface Props {
  name: "github" | "linkedin" | "mail" | "file" | "arrow" | "back";
  size?: number;
}
const { name, size = 18 } = Astro.props;
const brand = name === "github" ? faGithub : name === "linkedin" ? faLinkedinIn : null;
const [bw, bh, , , bPaths] = brand ? brand.icon : [0, 0, null, null, ""];
const brandPaths = Array.isArray(bPaths) ? bPaths : [bPaths];
---

{
  brand ? (
    <svg class="icon" viewBox={`0 0 ${bw} ${bh}`} width={size} height={size} aria-hidden="true" focusable="false">
      {brandPaths.map((d) => <path d={d} fill="currentColor" />)}
    </svg>
  ) : (
    <svg
      class="icon"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {name === "mail" && (
        <>
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </>
      )}
      {name === "file" && (
        <>
          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
          <path d="M14 3v5h5M9 13h6M9 17h6" />
        </>
      )}
      {name === "arrow" && <path d="M7 17 17 7M8 7h9v9" />}
      {name === "back" && <path d="M19 12H5m6-6-6 6 6 6" />}
    </svg>
  )
}
