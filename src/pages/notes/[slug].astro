---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Icon from "../../components/Icon.astro";
import profile from "../../lib/profile";
import { collection } from "../../lib/content";

export function getStaticPaths() {
  const notes = collection(
    import.meta.glob("../../content/notes/*.md", { eager: true }),
  ).filter((entry) => !entry.draft);

  return notes.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const EntryContent = entry.Component;
---

<BaseLayout title={`${entry.title} · ${profile.fullName}`} description={entry.summary ?? profile.seoDescription}>
  <SiteHeader variant="detail" />

  <main id="main-content" class="detail shell note">
    <a class="back-link" href="/"><Icon name="back" size={15} /> Home</a>
    <header class="detail-header">
      <p class="detail-kicker">{entry.dateWritten ?? entry.date}</p>
      <h1>{entry.title}</h1>
      {entry.summary ? <p class="detail-summary">{entry.summary}</p> : null}
    </header>
    <article class="prose detail-prose">
      <EntryContent />
    </article>
  </main>

  <SiteFooter />
</BaseLayout>
