---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Icon from "../../components/Icon.astro";
import profile from "../../lib/profile";
import { collection, hasNotesPage, highlightAuthor, inlineMarkdown } from "../../lib/content";

export function getStaticPaths() {
  const entries = collection(
    import.meta.glob("../../content/publications/*.md", { eager: true }),
  ).filter(hasNotesPage);

  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      others: entries
        .filter((other) => other.slug !== entry.slug)
        .map(({ slug, title, journal, date }) => ({ slug, title, journal, date })),
    },
  }));
}

const { entry, others } = Astro.props;
const EntryContent = entry.Component;
const doiUrl = entry.doi ? `https://doi.org/${entry.doi}` : undefined;
const primaryHref = doiUrl ?? entry.href;
---

<BaseLayout
  title={`${entry.tabLabel ?? entry.title.replaceAll("*", "")} · ${profile.fullName}`}
  description={entry.summary ?? profile.seoDescription}
>
  <SiteHeader variant="detail" />

  <main id="main-content" class="detail shell">
    <a class="back-link" href="/#publications"><Icon name="back" size={15} /> All publications</a>

    <header class="detail-header">
      <p class="detail-kicker">
        {entry.category === "under-review" ? "Manuscript in review" : "Paper notes"}
        <span lang="es"> · notas</span>
      </p>
      <h1 set:html={inlineMarkdown(entry.title)} />
      <p class="pub-authors" set:html={highlightAuthor(entry.authors)} />
      <p class="detail-venue">
        <em>{entry.journal}</em>{entry.date ? ` · ${entry.date}` : null}
        {entry.status && entry.status !== "Published" ? ` · ${entry.status}` : null}
      </p>
      {entry.summary ? <p class="detail-summary">{entry.summary}</p> : null}
      <div class="hero-actions">
        {
          primaryHref && entry.category !== "under-review" ? (
            <a class="button button-primary" href={primaryHref}>
              Read the paper <Icon name="arrow" size={15} />
            </a>
          ) : null
        }
        {
          entry.repositoryHref ? (
            <a class="button button-ghost" href={entry.repositoryHref}>
              <Icon name="github" size={16} /> Companion repository
            </a>
          ) : null
        }
      </div>
    </header>

    <div class="detail-grid">
      <article class="prose detail-prose">
        {
          entry.figureImage ? (
            <figure class="detail-figure">
              <img
                src={entry.figureImage}
                alt={entry.figureAlt ?? entry.title}
                width={entry.figureWidth}
                height={entry.figureHeight}
                loading="lazy"
                decoding="async"
              />
              {entry.figureCaption || entry.figureSource ? (
                <figcaption>
                  {entry.figureCaption}
                  {entry.figureSource ? (
                    <>
                      {" "}
                      <a href={entry.figureSource}>Source</a>
                    </>
                  ) : null}
                </figcaption>
              ) : null}
            </figure>
          ) : null
        }
        <EntryContent />
      </article>

      <aside class="detail-aside" aria-label="Publication details">
        <dl class="facts">
          {entry.journal ? <div><dt>Venue</dt><dd>{entry.journal}</dd></div> : null}
          {entry.date ? <div><dt>Year</dt><dd>{entry.date}</dd></div> : null}
          {entry.doi ? <div><dt>DOI</dt><dd><a href={doiUrl}>{entry.doi}</a></dd></div> : null}
          {entry.dateWritten ? <div><dt>Notes written</dt><dd>{entry.dateWritten}</dd></div> : null}
        </dl>
        {
          entry.tags?.length ? (
            <ul class="tags">
              {entry.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          ) : null
        }
      </aside>
    </div>

    <nav class="more-papers" aria-labelledby="more-title">
      <h2 id="more-title">More papers <span lang="es">más publicaciones</span></h2>
      <ul>
        {
          others.map((other) => (
            <li>
              <a href={`/publications/${other.slug}/`}>
                <span class="meta">{other.date} · {other.journal}</span>
                <strong set:html={inlineMarkdown(other.title)} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>

  <SiteFooter />
</BaseLayout>
