---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionHeading from "../components/SectionHeading.astro";
import AndeanBand from "../components/AndeanBand.astro";
import Icon from "../components/Icon.astro";
import profile from "../lib/profile";
import {
  collection,
  firstEntry,
  hasNotesPage,
  highlightAuthor,
  inlineMarkdown,
  publicationGroups,
} from "../lib/content";

const about = firstEntry(import.meta.glob("../content/about/*.md", { eager: true }));
const AboutContent = about.Component;
const education = collection(import.meta.glob("../content/education/*.md", { eager: true }));
const experience = collection(import.meta.glob("../content/experience/*.md", { eager: true }));
const publications = collection(import.meta.glob("../content/publications/*.md", { eager: true }));
const projects = collection(import.meta.glob("../content/projects/*.md", { eager: true }));
const featuredProjects = projects.filter((entry) => !entry.tags?.includes("earlier"));
const earlierProjects = projects.filter((entry) => entry.tags?.includes("earlier"));
const honors = collection(import.meta.glob("../content/honors/*.md", { eager: true }));
const talks = collection(import.meta.glob("../content/talks/*.md", { eager: true }));
const service = collection(import.meta.glob("../content/service/*.md", { eager: true }));

const groupedPublications = publicationGroups
  .map((group) => ({
    ...group,
    entries: publications.filter((entry) => entry.category === group.key),
  }))
  .filter((group) => group.entries.length > 0);
const publishedCount = publications.filter((entry) =>
  ["peer-reviewed", "proceedings"].includes(entry.category ?? ""),
).length;

const mailto = `mailto:${profile.email}`;
---

<BaseLayout
  title={`${profile.fullName} · ${profile.role}, ${profile.institution}`}
  description={profile.seoDescription}
>
  <SiteHeader />

  <main id="main-content">
    <!-- ───────── Hero ───────── -->
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">{profile.fullName}</h1>
        <p class="hero-role">
          <span>{profile.role}</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>{profile.institution}</span>
        </p>
        <p class="hero-intro">{profile.introduction}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={profile.cvUrl}>
            <Icon name="file" size={17} /> Curriculum vitae
          </a>
          <a class="button button-ghost" href={mailto}>
            <Icon name="mail" size={17} /> Email
          </a>
          <a class="icon-link" href={profile.githubUrl} aria-label="GitHub" title="GitHub">
            <Icon name="github" size={19} />
          </a>
          <a class="icon-link" href={profile.linkedInUrl} aria-label="LinkedIn" title="LinkedIn">
            <Icon name="linkedin" size={19} />
          </a>
        </div>
      </div>
      <figure class="hero-portrait">
        <AndeanBand id="band-portrait" class="portrait-weave" height="100%" />
        <img
          src={profile.portraitImage}
          alt={profile.portraitAlt}
          width="675"
          height="900"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </section>

    <!-- ───────── About ───────── -->
    <section id="about" class="section shell" aria-labelledby="about-title">
      <SectionHeading id="about-title" number="01" title="About" es="perfil" />
      <div class="about-grid">
        <div>
          <div class="prose">
            <AboutContent />
          </div>
          <h3 class="interests-title" id="research">Research interests</h3>
          <ul class="tags tags-lg">
            {profile.researchInterests.map((interest) => <li>{interest}</li>)}
          </ul>
        </div>
        <aside class="about-aside" aria-label="Education">
          <h3 class="aside-title">Education</h3>
          <ul class="edu-list">
            {
              education.map((entry) => (
                <li>
                  <span class="meta">{entry.date}</span>
                  <strong>{entry.title}</strong>
                  <span>{entry.subtitle}</span>
                  {entry.summary ? <span class="muted">{entry.summary}</span> : null}
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>

    <!-- ───────── Publications ───────── -->
    <section id="publications" class="section shell" aria-labelledby="publications-title">
      <SectionHeading id="publications-title" number="02" title="Publications" es="publicaciones">
        <p class="section-aside">
          {publishedCount} published · <a href={profile.cvUrl}>full list in CV</a>
        </p>
      </SectionHeading>
      {
        groupedPublications.map((group) => (
          <div class="pub-group">
            <h3 class="pub-group-title">
              {group.label}
              <span lang="es">{group.es}</span>
            </h3>
            <ol class="pub-list">
              {group.entries.map((entry) => (
                <li class="pub">
                  {hasNotesPage(entry) ? (
                    <a
                      class="pub-title"
                      href={`/publications/${entry.slug}/`}
                      set:html={inlineMarkdown(entry.title)}
                    />
                  ) : (
                    <span class="pub-title" set:html={inlineMarkdown(entry.title)} />
                  )}
                  <p class="pub-meta">
                    <span class="pub-authors" set:html={highlightAuthor(entry.authors)} />
                    {entry.journal ? (
                      <>
                        {" · "}
                        <em>{entry.journal}</em>{[
                          group.key !== "in-preparation" ? entry.date : undefined,
                          entry.category === "under-review" ? entry.status : undefined,
                        ]
                          .filter(Boolean)
                          .map((part) => `, ${part}`)
                          .join("")}
                      </>
                    ) : null}
                    <span class="pub-links">
                      {entry.doi ? <a href={`https://doi.org/${entry.doi}`}>DOI</a> : null}
                      {hasNotesPage(entry) ? <a href={`/publications/${entry.slug}/`}>Notes</a> : null}
                      {entry.repositoryHref ? <a href={entry.repositoryHref}>Code</a> : null}
                      {!entry.doi && entry.href && entry.linkLabel ? (
                        <a href={entry.href}>{entry.linkLabel}</a>
                      ) : null}
                    </span>
                  </p>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </section>

    <!-- ───────── Projects ───────── -->
    <section id="projects" class="section shell" aria-labelledby="projects-title">
      <SectionHeading id="projects-title" number="03" title="Projects & code" es="proyectos">
        <a class="section-aside link-arrow" href={profile.githubUrl}>
          GitHub profile <Icon name="arrow" size={14} />
        </a>
      </SectionHeading>
      <div class="project-grid">
        {
          featuredProjects.map((entry) => (
            <article class="project-card">
              <p class="meta">
                {entry.date}
                {entry.subtitle ? ` · ${entry.subtitle}` : null}
              </p>
              <h3>{entry.title}</h3>
              <p class="project-summary">{entry.summary}</p>
              {entry.status ? <p class="project-status">{entry.status}</p> : null}
              <p class="project-links">
                {entry.href ? (
                  <a href={entry.href}>
                    <Icon name="github" size={14} /> Code
                  </a>
                ) : null}
                {entry.demoHref ? (
                  <a href={entry.demoHref}>
                    Demo <Icon name="arrow" size={13} />
                  </a>
                ) : null}
                {entry.secondaryHref ? (
                  <a href={entry.secondaryHref}>
                    {entry.secondaryLabel ?? "Link"} <Icon name="arrow" size={13} />
                  </a>
                ) : null}
              </p>
            </article>
          ))
        }
      </div>
      {
        earlierProjects.length ? (
          <div class="earlier">
            <h3 class="interests-title">Earlier projects</h3>
            <ul>
              {earlierProjects.map((entry) => (
                <li>
                  <span class="meta">{entry.date}</span>
                  <span>
                    {entry.href ? <a href={entry.href}>{entry.title}</a> : <strong>{entry.title}</strong>}
                    <span class="muted"> — {entry.summary}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ) : null
      }
    </section>

    <!-- ───────── Experience ───────── -->
    <section id="experience" class="section shell" aria-labelledby="experience-title">
      <SectionHeading id="experience-title" number="04" title="Research experience" es="trayectoria" />
      <ol class="timeline">
        {
          experience.map((entry) => (
            <li class="timeline-item">
              <p class="timeline-date">{entry.date}</p>
              <div class="timeline-body">
                <h3>{entry.title}</h3>
                <p class="timeline-place">
                  {entry.subtitle}
                  {entry.venue ? <span class="muted"> · {entry.venue}</span> : null}
                </p>
                {entry.pi ? <p class="timeline-pi">PI: {entry.pi}</p> : null}
                <p>{entry.summary}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ───────── Honors + talks ───────── -->
    <section class="section shell two-up" aria-label="Honors, talks and media">
      <div id="honors">
        <SectionHeading id="honors-title" number="05" title="Honors & funding" es="premios" />
        <ul class="ledger">
          {
            honors.map((entry) => (
              <li>
                <span class="ledger-date">{entry.date}</span>
                <div>
                  <strong>
                    {entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}
                  </strong>
                  {entry.summary ? <p>{entry.summary}</p> : null}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div id="talks">
        <SectionHeading id="talks-title" number="06" title="Talks & posters" es="presentaciones" />
        <ul class="ledger">
          {
            talks.map((entry) => (
              <li>
                <span class="ledger-date">{entry.date}</span>
                <div>
                  <span class="kind">{entry.kind}</span>
                  <strong>
                    {entry.href ? (
                      <a href={entry.href} set:html={inlineMarkdown(entry.title)} />
                    ) : (
                      <span set:html={inlineMarkdown(entry.title)} />
                    )}
                  </strong>
                  <p>{entry.venue}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ───────── Mentoring & service ───────── -->
    <section id="service" class="section shell" aria-labelledby="service-title">
      <SectionHeading id="service-title" number="07" title="Mentoring & service" es="docencia y servicio" />
      <ul class="service-list">
        {
          service.map((entry) => (
            <li>
              <span class="kind">{entry.kind}</span>
              <strong>
                {entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}
              </strong>
              <span class="muted">
                {entry.subtitle} · {entry.date}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ───────── Contact ───────── -->
    <section id="contact" class="section shell contact" aria-labelledby="contact-title">
      <SectionHeading id="contact-title" number="08" title="Contact" es="contacto" />
      <div class="contact-row">
        <div>
          <p class="contact-note">{profile.contactNote}</p>
          <a class="contact-email" href={mailto}>{profile.email}</a>
        </div>
        <div class="contact-links">
          <a class="icon-link" href={profile.githubUrl} aria-label="GitHub" title="GitHub">
            <Icon name="github" size={19} />
          </a>
          <a class="icon-link" href={profile.linkedInUrl} aria-label="LinkedIn" title="LinkedIn">
            <Icon name="linkedin" size={19} />
          </a>
          <a class="icon-link" href={profile.cvUrl} aria-label="Curriculum vitae (PDF)" title="CV">
            <Icon name="file" size={19} />
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
