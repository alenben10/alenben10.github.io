---
import "../styles/global.css";
import profile from "../lib/profile";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, profile.siteUrl).toString();
const portraitUrl = new URL(profile.portraitImage, profile.siteUrl).toString();
const socialImageUrl = new URL("/og.png", profile.siteUrl).toString();
const nameKeywords = [profile.fullName, ...profile.alternateNames].join(", ");
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${profile.siteUrl}/#person`,
      name: profile.fullName,
      givenName: "Alen",
      familyName: "Zimic-Sheen",
      additionalName: "Zimic Sheen",
      alternateName: profile.alternateNames,
      url: profile.siteUrl,
      image: portraitUrl,
      email: `mailto:${profile.email}`,
      jobTitle: profile.role,
      sameAs: [profile.githubUrl, profile.linkedInUrl],
      affiliation: { "@type": "CollegeOrUniversity", name: profile.institution },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Universidad Peruana Cayetano Heredia" },
      nationality: { "@type": "Country", name: "Peru" },
      knowsLanguage: ["es", "en"],
      knowsAbout: [
        "Computational biology",
        "Bioinformatics",
        "Machine learning",
        "Protein language models",
        "Large language models",
        "Knowledge graphs",
        "Genomics",
        "Metagenomics",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${profile.siteUrl}/#website`,
      name: profile.fullName,
      alternateName: profile.alternateNames,
      url: profile.siteUrl,
      author: { "@id": `${profile.siteUrl}/#person` },
      inLanguage: "en",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.fullName} />
    <meta
      name="keywords"
      content={`${nameKeywords}, computational biology, bioinformatics, machine learning, Cornell University, Peru`}
    />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="SG10dQM62fAg4iT5IRWIfZ_8J4eu1l--00fpeox_0xk" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf7f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171311" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.fullName} — ${profile.role}, ${profile.institution}`} />
    <meta property="og:site_name" content={profile.fullName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
